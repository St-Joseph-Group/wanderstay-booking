# Copy to .env.local and fill in. All optional for local dev — features that
# depend on a key gracefully no-op (and log) until it is set.

# --- Supabase (has committed dev fallbacks; override for your own project) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Site URL (used to build email verification redirect links) ---
# In prod set to your canonical origin, e.g. https://wanderstay.com
NEXT_PUBLIC_SITE_URL=

# --- Transactional email (Resend) — enables booking-confirmation emails ---
# Get a key at resend.com. EMAIL_FROM must be a verified sender/domain.
RESEND_API_KEY=
EMAIL_FROM="Wanderstay <bookings@yourdomain.com>"

# --- Transactional SMS (Twilio) — optional booking-confirmation texts ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# --- Email verification (Supabase side, no env var) ---
# To actually enforce verification you must, in the Supabase dashboard:
#   1. Remove/disable the auto-confirm DB trigger on new users.
#   2. Enable email confirmations and configure SMTP (or use Supabase's).
#   3. Set the confirm email template URL to {{ .SiteURL }}/auth/confirm
#      and add that path to the redirect allowlist.
# The app code (signup "check your email" state, /auth/confirm callback, and the
# booking verified-email gate) is already in place and starts enforcing then.
